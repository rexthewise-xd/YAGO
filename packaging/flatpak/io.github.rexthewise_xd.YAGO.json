{
  "app-id": "io.github.rexthewise_xd.YAGO",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "yago",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=host",
    "--talk-name=org.freedesktop.Notifications",
    "--filesystem=xdg-run/app/com.discordapp.Discord:ro"
  ],
  "modules": [
    {
      "name": "yago",
      "buildsystem": "simple",
      "build-commands": [
        "install -D yago-ui /app/bin/yago",
        "cp -r assets /app/bin/ 2>/dev/null || true",
        "install -D -m 644 io.github.rexthewise_xd.YAGO.desktop /app/share/applications/io.github.rexthewise_xd.YAGO.desktop",
        "install -D -m 644 io.github.rexthewise_xd.YAGO.metainfo.xml /app/share/metainfo/io.github.rexthewise_xd.YAGO.metainfo.xml",
        "install -D -m 644 icons/32x32.png /app/share/icons/hicolor/32x32/apps/io.github.rexthewise_xd.YAGO.png",
        "install -D -m 644 icons/128x128.png /app/share/icons/hicolor/128x128/apps/io.github.rexthewise_xd.YAGO.png",
        "install -D -m 644 icons/Square150x150Logo.png /app/share/icons/hicolor/256x256/apps/io.github.rexthewise_xd.YAGO.png",
        "install -D -m 644 icons/icon.png /app/share/icons/hicolor/512x512/apps/io.github.rexthewise_xd.YAGO.png"
      ],
      "sources": [
        {
          "type": "file",
          "path": "../../target/dx/yago-ui/release/linux/app/yago-ui"
        },
        {
          "type": "dir",
          "path": "../../target/dx/yago-ui/release/linux/app/assets",
          "dest": "assets"
        },
        {
          "type": "file",
          "path": "io.github.rexthewise_xd.YAGO.desktop"
        },
        {
          "type": "file",
          "path": "io.github.rexthewise_xd.YAGO.metainfo.xml"
        },
        {
          "type": "dir",
          "path": "../../src-ui-rs/assets/icons",
          "dest": "icons"
        }
      ]
    }
  ]
}
